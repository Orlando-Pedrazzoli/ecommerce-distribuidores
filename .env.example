# ═══════════════════════════════════════════════════════════════
# ELITE SURFING PORTAL - VARIÁVEIS DE AMBIENTE
# Copie para .env.local e preencha. Na Vercel, cadastre em Settings > Environment Variables.
# ═══════════════════════════════════════════════════════════════

# Banco
MONGODB_URI=mongodb+srv://usuario:senha@cluster.mongodb.net/ecommerce-distribuidores

# ── Autenticação ──
# Segredo do JWT (sessão, OTP pendente, dispositivo confiável). Mínimo 32 caracteres.
# Gerar: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# (NEXTAUTH_SECRET continua aceite como fallback)
JWT_SECRET=

# URL pública do site (usada nos links de email: reset de senha, convite)
BASE_URL=https://portal.elitesurfing.com.br

# ── Email (SMTP) ──
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
# Recebe os emails de novos pedidos e é o email do admin para OTP/reset
ADMIN_EMAIL=

# ── Cloudinary ──
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Regras de negócio ──
ROYALTY_PERCENTAGE=0.05

# ═══════════════════════════════════════════════════════════════
# LEGADO — usado APENAS por `node scripts/migrar-usuarios.js`
# Depois da migração REMOVA estas variáveis (local e Vercel).
# ═══════════════════════════════════════════════════════════════
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=
# DISTRIBUIDOR_1=usuario:senha:Nome Completo:email@exemplo.com:(11) 99999-9999:Rua:123:Compl:Bairro:Cidade:00000-000:SP
